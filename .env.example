# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file.

# Port the server listens on
PORT=3000
NODE_ENV=development

# Get a key from https://aistudio.google.com/apikey (used only on the server)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name. If you get a "model not found" error, check which models
# your key can use in Google AI Studio and put that name here.
GEMINI_MODEL=gemini-2.5-flash

# All "today" / "tomorrow" logic uses this timezone (IANA name)
APP_TIMEZONE=Asia/Kolkata

# Where the SQLite file is stored (folder is created automatically)
DATABASE_PATH=./data/taskpilot.db

# The planner only suggests slots inside this window (24 hour HH:mm)
WORKDAY_START=09:00
WORKDAY_END=21:00

# Optional: if you fill this in, the /mcp endpoint needs the header
#   Authorization: Bearer <this value>
# Leave it empty for local demos.
MCP_AUTH_TOKEN=